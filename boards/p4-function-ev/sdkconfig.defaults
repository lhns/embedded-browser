# Common to all MCUs; sdkconfig.defaults.<mcu> adds the chip-specific PSRAM settings.

# 16 MB flash. The partition table (partitions.csv, ~14 MB factory app) is written by espflash
# (espflash.toml, `--partition-table`), not by the ESP-IDF build: esp-idf-sys generates the CMake
# project in the target dir, where a relative CONFIG_PARTITION_TABLE_CUSTOM_FILENAME isn't found.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# PSRAM as part of the malloc heap: small allocations stay internal, large ones (frame buffer,
# DOM/style arenas) go to PSRAM. Keep internal RAM for DMA, Wi-Fi and stacks.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# The engine thread's 512 KB stack is allocated in PSRAM (see src/main.rs).
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Big stacks: the main task only spawns the engine thread, but Rust std needs headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=32768
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# Rendering runs for seconds on one core: don't trip the idle-task watchdog.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_FREERTOS_HZ=1000
